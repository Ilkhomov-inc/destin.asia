// Prisma schema for the tourism company website.
// NOTE: SQLite is used for local development. For production on Supabase
// (Postgres), an equivalent SQL schema is provided in /SUPABASE_SETUP.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A destination/place: e.g. Bali, Kyoto, Santorini.
model Location {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            String
  region           String
  category         String
  shortDescription String
  description      String
  bestSeason       String
  // JSON-encoded string array of "what to see" bullet points.
  whatToSee        String           @default("[]")
  status           String           @default("PUBLISHED") // PUBLISHED | DRAFT
  images           LocationImage[]
  tours            TourLocation[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([region])
  @@index([category])
}

model LocationImage {
  id         String   @id @default(cuid())
  locationId String
  url       String
  order     Int      @default(0)
  location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

// A tour programme. type: BASIC (fixed programme/price/dates) | INDIVIDUAL (custom).
model Tour {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  type          String        // BASIC | INDIVIDUAL
  description   String
  durationDays  Int
  price         String
  startDate     String?
  // JSON-encoded string array of included items.
  included      String        @default("[]")
  // JSON-encoded string array of not-included items.
  notIncluded   String        @default("[]")
  // JSON-encoded array of program days: [{day, title, description}]
  programDays   String        @default("[]")
  status        String        @default("PUBLISHED") // PUBLISHED | DRAFT
  images        TourImage[]
  locations     TourLocation[]
  inquiries     Inquiry[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([type])
  @@index([status])
}

model TourImage {
  id      String @id @default(cuid())
  tourId  String
  url     String
  order   Int    @default(0)
  tour    Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
}

// Many-to-many between Tour and Location.
model TourLocation {
  id         String   @id @default(cuid())
  tourId     String
  locationId String
  order      Int      @default(0)
  tour       Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([tourId, locationId])
  @@index([locationId])
}

// Public contact/inquiry requests submitted from the site.
model Inquiry {
  id        String   @id @default(cuid())
  name      String
  contact   String
  message   String
  tourId    String?
  tour      Tour?    @relation(fields: [tourId], references: [id], onDelete: SetNull)
  status    String   @default("NEW") // NEW | PROCESSED
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// Singleton row (id = "singleton") holding editable site-wide content.
model SiteSettings {
  id          String   @id @default("singleton")
  siteName    String
  tagline     String
  phone       String
  email       String
  whatsapp    String
  telegram   String
  address     String
  instagram   String?
  facebook    String?
  youtube     String?
  aboutText   String
  heroImage   String?
  updatedAt   DateTime @updatedAt
}
