# Password for /admin (choose a long one in production)
ADMIN_PASSWORD=
# Random string used to sign admin sessions: `openssl rand -hex 32`
ADMIN_SECRET=
# Public URL of the site, used for SEO links and sitemap
NEXT_PUBLIC_SITE_URL=https://destin.asia
# Supabase project (Settings → API). Without these the site uses .data/db.json (dev only).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Free CARTO basemaps key (carto.com/basemaps/apikey; commercial use free up to 1M requests/month).
# Without it the maps use OpenStreetMap tiles.
NEXT_PUBLIC_CARTO_KEY=
